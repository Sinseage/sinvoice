{
  "name": "sinvoice",
  "productName": "SINVoice",
  "version": "1.2.0",
  "description": "SINVoice — голосовой звонок с чатом и передачей файлов по прямому IP",
  "main": "main.js",
  "author": "Дмитрий Собенин (Sinseage)",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable --x64 --publish never"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.sinseage.sinvoice",
    "productName": "SINVoice",
    "copyright": "Дмитрий Собенин (Sinseage)",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "SINVoice-${version}.exe"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sinseage/sinvoice.git"
  }
}
